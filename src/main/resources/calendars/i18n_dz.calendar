<?xml version="1.0" encoding="UTF-8"?>
<!--
  Algeria Public Holidays Calendar (2027-2030)
  ============================================

  DATA SOURCES:
  - 2027: https://www.timeanddate.com/holidays/algeria/2027
  - 2028: https://www.timeanddate.com/holidays/algeria/2028
  - 2029: https://www.timeanddate.com/holidays/algeria/2029
  - 2030: https://www.timeanddate.com/holidays/algeria/2030

  LEGAL REFERENCES:
  - Algerian Law No. 23-10 of June 26, 2023 (amending Law No. 63-278).
  - Official Journal of the Algerian Republic, Issue No. 43 (June 27, 2023).
  - Official PDF (Arabic): https://www.joradp.dz/FTP/JO-arabe/2023/A2023043.pdf
  - Official PDF (French): https://www.joradp.dz/FTP/jo-francais/2023/F2023043.pdf

  CONTRIBUTOR:
  - Ayad Seghiri
  - GitHub: https://github.com/ayadseghairi
  - Email : seghiri.ayad@univ-khenchela.dz

  NOTES:
  - Islamic holiday dates are estimated based on astronomical calculations.
  - Actual dates may vary by one day depending on the official
    moon sighting announcement by the Ministry of Religious Affairs in Algeria.
  - Eid al-Fitr and Eid al-Adha are three-day public holidays
    according to Algerian Law No. 23-10.
-->

<calendar id="dz" name="Algeria Holidays" type="country">

	<date year="" month="01" date="01"><![CDATA[New Year's Day]]></date>
	<date year="" month="01" date="12"><![CDATA[Yennayer (Amazigh New Year)]]></date>
	<date year="" month="05" date="01"><![CDATA[Labour Day]]></date>
	<date year="" month="07" date="05"><![CDATA[Independence Day]]></date>
	<date year="" month="11" date="01"><![CDATA[Revolution Day]]></date>

	<!-- Islamic holidays 2027 -->
	<date year="2027" month="03" date="09"><![CDATA[Eid al-Fitr]]></date>
	<date year="2027" month="03" date="10"><![CDATA[Eid al-Fitr Holiday]]></date>
	<date year="2027" month="03" date="11"><![CDATA[Eid al-Fitr Holiday]]></date>
	
	<date year="2027" month="05" date="16"><![CDATA[Eid al-Adha]]></date>
	<date year="2027" month="05" date="17"><![CDATA[Eid al-Adha Holiday]]></date>
	<date year="2027" month="05" date="18"><![CDATA[Eid al-Adha Holiday]]></date>
	
	<date year="2027" month="06" date="06"><![CDATA[Islamic New Year]]></date>
	<date year="2027" month="06" date="15"><![CDATA[Ashura]]></date>
	
	<date year="2027" month="08" date="14"><![CDATA[Prophet's Birthday]]></date>

	<!-- Islamic holidays 2028 -->
	<date year="2028" month="02" date="27"><![CDATA[Eid al-Fitr]]></date>
	<date year="2028" month="02" date="28"><![CDATA[Eid al-Fitr Holiday]]></date>
	<date year="2028" month="02" date="29"><![CDATA[Eid al-Fitr Holiday]]></date>
	
	<date year="2028" month="05" date="05"><![CDATA[Eid al-Adha]]></date>
	<date year="2028" month="05" date="06"><![CDATA[Eid al-Adha Holiday]]></date>
	<date year="2028" month="05" date="07"><![CDATA[Eid al-Adha Holiday]]></date>
	
	<date year="2028" month="05" date="25"><![CDATA[Islamic New Year]]></date>
	<date year="2028" month="06" date="03"><![CDATA[Ashura]]></date>
	<date year="2028" month="08" date="03"><![CDATA[Prophet's Birthday]]></date>
	
	<!-- Islamic holidays 2029 -->
	<date year="2029" month="02" date="15"><![CDATA[Eid al-Fitr]]></date>
	<date year="2029" month="02" date="16"><![CDATA[Eid al-Fitr Holiday]]></date>
	<date year="2029" month="02" date="17"><![CDATA[Eid al-Fitr Holiday]]></date>
	
	<date year="2029" month="04" date="24"><![CDATA[Eid al-Adha]]></date>
	<date year="2029" month="04" date="25"><![CDATA[Eid al-Adha Holiday]]></date>
	<date year="2029" month="04" date="26"><![CDATA[Eid al-Adha Holiday]]></date>
	
	<date year="2029" month="05" date="15"><![CDATA[Islamic New Year]]></date>
	<date year="2029" month="05" date="24"><![CDATA[Ashura]]></date>
	<date year="2029" month="07" date="24"><![CDATA[Prophet's Birthday]]></date>
	
	<!-- Islamic holidays 2030 -->
	<date year="2030" month="02" date="05"><![CDATA[Eid al-Fitr]]></date>
	<date year="2030" month="02" date="06"><![CDATA[Eid al-Fitr Holiday]]></date>
	<date year="2030" month="02" date="07"><![CDATA[Eid al-Fitr Holiday]]></date>
	
	<date year="2030" month="04" date="14"><![CDATA[Eid al-Adha]]></date>
	<date year="2030" month="04" date="15"><![CDATA[Eid al-Adha Holiday]]></date>
	<date year="2030" month="04" date="16"><![CDATA[Eid al-Adha Holiday]]></date>
	
	<date year="2030" month="05" date="04"><![CDATA[Islamic New Year]]></date>
	<date year="2030" month="05" date="13"><![CDATA[Ashura]]></date>
	<date year="2030" month="07" date="13"><![CDATA[Prophet's Birthday]]></date>

</calendar>
